# Copy to .env — never commit .env
ARC_TESTNET_RPC_URL="https://rpc.testnet.arc.io"
ARC_MAINNET_RPC_URL="https://rpc.mainnet.arc.io"
# Keys are never stored here. Use an encrypted keystore:
#   cast wallet new ~/.foundry/keystores deployer   →   --account deployer

# Deploy (script/Deploy.s.sol)
ATTESTER="0x712Cd65028834563734f63039354c8278079E358"
# 300 on testnet; mainnet requires 172800 (48h)
ACTIVATION_DELAY=300

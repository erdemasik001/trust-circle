# testnet | mainnet
NEXT_PUBLIC_ARC_NETWORK=testnet
# Optional: a dedicated RPC (Alchemy, QuickNode, dRPC…). Defaults to the public Arc RPC.
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=

# World ID 4.0 (developer.world.org → your app → World ID)
NEXT_PUBLIC_WORLD_APP_ID=app_f8a649fff2ebca2d74c084dcf8c0d0a0
NEXT_PUBLIC_WORLD_RP_ID=
NEXT_PUBLIC_WORLD_ACTION=trustcircle-register
# production for real phones; staging only with simulator.worldcoin.org
NEXT_PUBLIC_WORLD_ENVIRONMENT=production
# selfieCheck | deviceLegacy | proofOfHuman — must match the action's credential in the portal
NEXT_PUBLIC_WORLD_CREDENTIAL=selfieCheck

# ─── Server secrets: set in .env.local / Vercel, never commit, never NEXT_PUBLIC_ ───
# World ID RP signing key (shown once by the portal)
RP_SIGNING_KEY=
# Private key of the attester wallet (TrustCircle.attester). Export it with:
#   cast wallet decrypt-keystore attester
ATTESTER_PRIVATE_KEY=
